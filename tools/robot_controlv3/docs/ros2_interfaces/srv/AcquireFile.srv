# Acquisition (detection + alignement + sauvegarde crop) d'une image sur disque.
# Remplace RecognitionConfig.command == "acquire_file" (motif `seq` -> service).

string  path          # chemin de l'image a acquerir
string  id_lot        # lot cible (meme personne) ; vide => genere
---
bool    success
string  id_lot        # lot effectivement utilise
uint32  saved         # nombre de crops ecrits (0 = aucun visage exploitable)
