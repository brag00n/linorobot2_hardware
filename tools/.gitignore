# environnement Python local (recree par install.ps1 / install.sh)
.venv/

# caches Python
__pycache__/
*.pyc

# ancienne implementation de reference (analyse seule, non versionnee)
Bambou4WD_V1-master/

# donnees runtime (jeu de visages : crops + galerie SFace) - non versionnees
data/

# telemetrie runtime de l'app (robot_control/lib/Telemetry.py + snapshots d'analyse)
# les logs peuvent atterrir dans logs/ de n'importe quel paquet applicatif
**/logs/robot_control.jsonl
**/logs/robot_control.jsonl.*
**/logs/state.json
**/logs/state.json.tmp
**/logs/latest.jpg
**/logs/latest.jpg.tmp
**/logs/session_*.jsonl
